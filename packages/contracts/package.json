{
  "name": "@mediavault/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Platform-neutral TypeScript contracts for MediaVault API clients",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && npm run typecheck && node test/contracts.test.cjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
