{
  "name": "mediavault-clients",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "start:mobile": "npm run start --workspace=media-vault-android",
    "android": "npm run android --workspace=media-vault-android",
    "dev:web": "npm run dev --workspace=media-vault-app.client",
    "lint": "npm run lint --workspace=media-vault-android && npm run lint --workspace=media-vault-app.client",
    "typecheck:mobile": "npm exec --workspace=media-vault-android -- tsc --noEmit",
    "doctor:mobile": "npm exec --workspace=media-vault-android -- expo-doctor",
    "build:web": "npm run build --workspace=media-vault-app.client",
    "test:result-pattern": "npm test --workspace=result-pattern-typescript"
  }
}
